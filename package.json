{
  "name": "epi-info-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch apps/agent/src/index.ts",
    "dev:display": "vite --config apps/display/vite.config.ts --host 0.0.0.0",
    "build": "tsc -p apps/agent/tsconfig.json && vite build --config apps/display/vite.config.ts",
    "start": "node dist/agent/src/index.js",
    "lint": "tsc --noEmit -p apps/agent/tsconfig.json && tsc --noEmit -p apps/display/tsconfig.json",
    "test": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18.19.0",
    "npm": ">=9.2.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.2.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/ws": "^8.5.10",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}

